    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-xml-parser": "^5.11.2",
    "oxlint": "^1.88.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
